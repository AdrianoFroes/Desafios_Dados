    <action>
      <name>Fim qualidade</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO auditoria.etapa (execucao_id, etapa, evento, resultado) SELECT '${EXECUCAO_ID}', 'qualidade', 'fim', CASE WHEN EXISTS (SELECT 1 FROM qualidade.resultado WHERE execucao_id = '${EXECUCAO_ID}' AND NOT aprovado) THEN 'sucesso com ressalvas' ELSE 'sucesso' END;</sql>
