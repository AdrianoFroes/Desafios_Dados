<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>orquestrador</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Workflow orquestrador (RF22). Ordem: Bronze, Silver, Qualidade, Gold, Publicacao de metadados. Qualidade e Gold publicam a camada analitica. Metadados grava o snapshot tecnico da Gold em auditoria.metadados; a ingestao no OpenMetadata roda logo depois (scripts/07_openmetadata_catalogo.ps1).</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/27 00:15:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/27 00:15:00.000</modified_date>
  <parameters>
