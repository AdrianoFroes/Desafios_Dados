<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Identificador unico (UUID) da execucao. Em producao e propagado pelo workflow orquestrador (RF22).</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>falha_arquivo_json</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/26 23:55:00.000</created_date>
    <modified_date>2026/09/26 23:55:00.000</modified_date>
  </info>
  <transform>
    <type>JsonInput</type>
    <name>Ler JSON</name>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <rownum_field/>
    <limit>0</limit>
    <valueField/>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <addresultfile>N</addresultfile>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <ignoreMissingPath>N</ignoreMissingPath>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <files>
      <file>
        <name>/dados/brutos/_comentario_corrompido.json</name>
        <filemask/>
        <exclude_filemask/>
        <file_required>N</file_required>
        <include_subfolders>N</include_subfolders>
      </file>
    </files>
    <fields>
      <field>
        <name>usuario_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>$.[*].usuario_id</path>
      </field>
      <field>
        <name>conteudo_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>$.[*].conteudo_id</path>
      </field>
      <field>
        <name>comentario</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>$.[*].comentario</path>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>224</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Arquivo valido</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>Montar registro de quarentena</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>arquivo:/dados/brutos/_comentario_corrompido.json</nullif>
        <name>registro_id</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>comentarios</nullif>
        <name>origem</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>ARQUIVO_CORROMPIDO</nullif>
        <name>regra_violada</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <name>mensagem</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>{}</nullif>
        <name>payload_original</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>320</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>So o erro real de parse</name>
    <send_true_to>Get Variables</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>Y</negated>
        <leftvalue>erro_descricao</leftvalue>
        <function>CONTAINS</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>No file(s) specified</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>496</xloc>
      <yloc>240</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Get Variables</name>
    <fields>
      <field>
        <name>execucao_id</name>
        <variable>${EXECUCAO_ID}</variable>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>704</xloc>
      <yloc>320</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Gravar quarentena</name>
    <connection>pg_desafio</connection>
    <schema>quarentena</schema>
    <table>registro</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>registro_id</stream_name>
        <column_name>registro_id</column_name>
      </field>
      <field>
        <stream_name>origem</stream_name>
        <column_name>origem</column_name>
      </field>
      <field>
        <stream_name>regra_violada</stream_name>
        <column_name>regra_violada</column_name>
      </field>
      <field>
        <stream_name>erro_descricao</stream_name>
        <column_name>mensagem</column_name>
      </field>
      <field>
        <stream_name>execucao_id</stream_name>
        <column_name>execucao_id</column_name>
      </field>
      <field>
        <stream_name>payload_original</stream_name>
        <column_name>payload_original</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>896</xloc>
      <yloc>320</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler JSON</from>
      <to>Arquivo valido</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler JSON</from>
      <to>Montar registro de quarentena</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Montar registro de quarentena</from>
      <to>So o erro real de parse</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>So o erro real de parse</from>
      <to>Get Variables</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get Variables</from>
      <to>Gravar quarentena</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform_error_handling>
    <error>
      <source_transform>Ler JSON</source_transform>
      <target_transform>Montar registro de quarentena</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename/>
      <descriptions_valuename>erro_descricao</descriptions_valuename>
      <fields_valuename/>
      <codes_valuename>erro_codigo</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <notepads/>
  <attributes/>
</pipeline>
