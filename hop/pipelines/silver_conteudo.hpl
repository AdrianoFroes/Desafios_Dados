<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Identificador unico (UUID) da execucao Silver. Em producao e propagado pelo workflow orquestrador (RF22). Em teste manual, informe via Run Options antes de executar.</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>silver_conteudo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/26 22:00:00.000</created_date>
    <modified_date>2026/09/26 22:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Ler Bronze e aplicar regras</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <lookup/>
    <sql><![CDATA[
WITH base AS (
  SELECT
    b.conteudo_id                                   AS conteudo_id_raw,
    NULLIF(BTRIM(b.titulo), '')                      AS titulo,
    NULLIF(BTRIM(b.tipo), '')                        AS tipo_raw,
    NULLIF(BTRIM(b.categoria), '')                   AS categoria_raw,
    NULLIF(BTRIM(b.nivel), '')                       AS nivel_raw,
    NULLIF(BTRIM(b.carga_horaria_min), '')           AS carga_horaria_min_raw,
    NULLIF(BTRIM(b.data_publicacao), '')             AS data_publicacao_raw,
    NULLIF(BTRIM(b.descricao), '')                   AS descricao,
    NULLIF(BTRIM(b.autor), '')                       AS autor,
    b.origem, b.arquivo_origem, b.data_hora_ingestao, b.execucao_id,
    to_jsonb(b) AS payload_original,
    b.ctid AS linha_ctid
  FROM bronze.catalogo b
),
padronizado AS (
  SELECT *,
    CASE WHEN BTRIM(conteudo_id_raw) ~ '^\d+$'
      THEN BTRIM(conteudo_id_raw)::INTEGER ELSE NULL END AS conteudo_id,
    CASE UPPER(tipo_raw)
      WHEN 'ARTIGO' THEN 'Artigo'
      WHEN 'CURSO' THEN 'Curso'
      WHEN 'PODCAST' THEN 'Podcast'
      WHEN 'VÍDEO' THEN 'Vídeo'
      WHEN 'VIDEO' THEN 'Vídeo'
      ELSE tipo_raw
    END AS tipo,
    CASE UPPER(categoria_raw)
      WHEN 'BANCO DE DADOS' THEN 'Banco de Dados'
      WHEN 'BUSINESS INTELLIGENCE' THEN 'Business Intelligence'
      WHEN 'CIÊNCIA DE DADOS' THEN 'Ciência de Dados'
      WHEN 'CIENCIA DE DADOS' THEN 'Ciência de Dados'
      WHEN 'DEVOPS & CLOUD' THEN 'DevOps & Cloud'
      WHEN 'ENGENHARIA DE DADOS' THEN 'Engenharia de Dados'
      WHEN 'INTELIGÊNCIA ARTIFICIAL' THEN 'Inteligência Artificial'
      WHEN 'INTELIGENCIA ARTIFICIAL' THEN 'Inteligência Artificial'
      WHEN 'PROGRAMAÇÃO & SOFTWARE' THEN 'Programação & Software'
      WHEN 'PROGRAMACAO & SOFTWARE' THEN 'Programação & Software'
      WHEN 'SEGURANÇA & GOVERNANÇA' THEN 'Segurança & Governança'
      WHEN 'SEGURANCA & GOVERNANCA' THEN 'Segurança & Governança'
      ELSE categoria_raw
    END AS categoria,
    CASE UPPER(nivel_raw)
      WHEN 'BÁSICO' THEN 'Básico'
      WHEN 'BASICO' THEN 'Básico'
      WHEN 'INTERMEDIÁRIO' THEN 'Intermediário'
      WHEN 'INTERMEDIARIO' THEN 'Intermediário'
      WHEN 'AVANÇADO' THEN 'Avançado'
      WHEN 'AVANCADO' THEN 'Avançado'
      ELSE nivel_raw
    END AS nivel,
    CASE WHEN carga_horaria_min_raw ~ '^-?\d+(\.\d+)?$'
      THEN ROUND(carga_horaria_min_raw::NUMERIC)::INTEGER ELSE NULL END AS carga_horaria_min,
    CASE WHEN data_publicacao_raw ~ '^\d{4}-\d{2}-\d{2}$'
      THEN data_publicacao_raw::DATE ELSE NULL END AS data_publicacao
  FROM base
),
dedupe AS (
  SELECT *,
    ROW_NUMBER() OVER (
      PARTITION BY conteudo_id
      ORDER BY data_hora_ingestao, linha_ctid
    ) AS ocorrencia
  FROM padronizado
),
regras AS (
  SELECT *,
    CASE
      WHEN conteudo_id IS NULL THEN 'ID_INVALIDO'
      WHEN ocorrencia > 1 THEN 'DUPLICADO'
      WHEN tipo IS NULL OR tipo NOT IN ('Artigo','Curso','Podcast','Vídeo') THEN 'TIPO_FORA_DO_DOMINIO'
      WHEN categoria IS NULL OR categoria NOT IN (
        'Banco de Dados','Business Intelligence','Ciência de Dados','DevOps & Cloud',
        'Engenharia de Dados','Inteligência Artificial','Programação & Software','Segurança & Governança'
      ) THEN 'CATEGORIA_FORA_DO_DOMINIO'
      WHEN nivel IS NULL OR nivel NOT IN ('Básico','Intermediário','Avançado') THEN 'NIVEL_FORA_DO_DOMINIO'
      ELSE NULL
    END AS regra_violada
  FROM dedupe
)
SELECT
  conteudo_id, titulo, tipo, categoria, nivel, carga_horaria_min, data_publicacao,
  descricao, autor, origem, arquivo_origem, data_hora_ingestao, execucao_id,
  regra_violada,
  CASE regra_violada
    WHEN 'ID_INVALIDO' THEN 'conteudo_id ausente ou nao numerico na origem'
    WHEN 'DUPLICADO' THEN 'conteudo_id duplicado no Bronze; mantida apenas a primeira ocorrencia'
    WHEN 'TIPO_FORA_DO_DOMINIO' THEN 'tipo fora do dominio oficial (Artigo, Curso, Podcast, Video)'
    WHEN 'CATEGORIA_FORA_DO_DOMINIO' THEN 'categoria fora do dominio oficial das 8 categorias'
    WHEN 'NIVEL_FORA_DO_DOMINIO' THEN 'nivel fora do dominio oficial (Basico, Intermediario, Avancado)'
    ELSE NULL
  END AS mensagem,
  ('catalogo:conteudo_id=' || COALESCE(conteudo_id_raw, 'NULL')) AS registro_id,
  payload_original::text AS payload_original
FROM regras
]]></sql>
