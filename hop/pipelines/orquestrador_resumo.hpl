<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Execucao cujas etapas serao resumidas.</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>orquestrador_resumo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 00:10:00.000</created_date>
    <modified_date>2026/09/27 00:10:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Calcular duracao e resultado</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql><![CDATA[
WITH etapas AS (
  SELECT etapa,
         min(instante) FILTER (WHERE evento = 'inicio') AS inicio,
         max(instante) FILTER (WHERE evento = 'fim') AS fim,
         max(resultado) FILTER (WHERE evento = 'fim') AS resultado
  FROM auditoria.etapa
  WHERE execucao_id = '${EXECUCAO_ID}'
  GROUP BY etapa
),
final AS (
  SELECT CASE
    WHEN EXISTS (SELECT 1 FROM etapas WHERE resultado = 'falha') THEN 'falha'
    WHEN EXISTS (SELECT 1 FROM etapas WHERE resultado = 'sucesso com ressalvas') THEN 'sucesso com ressalvas'
    WHEN EXISTS (
      SELECT 1 FROM quarentena.registro
      WHERE execucao_id = '${EXECUCAO_ID}' AND status = 'pendente'
    ) THEN 'sucesso com ressalvas'
    ELSE 'sucesso'
  END AS resultado_final
)
SELECT e.etapa,
       to_char(e.inicio, 'YYYY-MM-DD HH24:MI:SS') AS inicio,
       to_char(e.fim, 'YYYY-MM-DD HH24:MI:SS') AS fim,
       round(extract(epoch FROM (e.fim - e.inicio))::numeric, 3) AS duracao_segundos,
       e.resultado,
       f.resultado_final,
       '${EXECUCAO_ID}' AS execucao_id
FROM etapas e
CROSS JOIN final f
ORDER BY e.inicio
]]></sql>
    <variables_active>Y</variables_active>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Logar resumo</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>RESUMO DA EXECUCAO</logmessage>
    <loglevel>Basic</loglevel>
    <fields>
      <field><name>execucao_id</name></field>
      <field><name>etapa</name></field>
      <field><name>inicio</name></field>
      <field><name>fim</name></field>
      <field><name>duracao_segundos</name></field>
      <field><name>resultado</name></field>
      <field><name>resultado_final</name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Resultado final</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql><![CDATA[
SELECT CASE
  WHEN EXISTS (
    SELECT 1 FROM auditoria.etapa
    WHERE execucao_id = '${EXECUCAO_ID}' AND resultado = 'falha'
  ) THEN 'falha'
  WHEN EXISTS (
    SELECT 1 FROM quarentena.registro
    WHERE execucao_id = '${EXECUCAO_ID}' AND status = 'pendente'
  ) THEN 'sucesso com ressalvas'
  ELSE 'sucesso'
END AS resultado_final
]]></sql>
    <variables_active>Y</variables_active>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Publicar resultado</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>resultado_final</field_name>
        <variable_name>RESULTADO_FINAL</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>224</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <order>
    <hop>
      <from>Calcular duracao e resultado</from>
      <to>Logar resumo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resultado final</from>
      <to>Publicar resultado</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
</pipeline>
