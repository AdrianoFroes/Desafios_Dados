<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Identificador unico (UUID) da execucao Silver. Em producao e propagado pelo workflow orquestrador (RF22). Em teste manual, informe via Run Options antes de executar. Este pipeline depende de silver_conteudo ja ter sido executado (valida conteudo_id contra silver.conteudo).</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>silver_comentario</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/26 23:20:00.000</created_date>
    <modified_date>2026/09/26 23:20:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Ler Bronze e aplicar regras</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <lookup/>
    <sql><![CDATA[
WITH base AS (
  SELECT
    b.usuario_id                            AS usuario_id_raw,
    b.conteudo_id                           AS conteudo_id_raw,
    NULLIF(BTRIM(b.avaliacao), '')           AS avaliacao_raw,
    NULLIF(BTRIM(b.comentario), '')          AS comentario,
    b.tags                                   AS tags_raw,
    NULLIF(BTRIM(b.data), '')                AS data_raw,
    b.origem, b.arquivo_origem, b.data_hora_ingestao, b.execucao_id,
    to_jsonb(b) AS payload_original,
    b.ctid AS linha_ctid
  FROM bronze.comentarios b
),
padronizado AS (
  SELECT *,
    CASE WHEN BTRIM(usuario_id_raw) ~ '^\d+$' AND BTRIM(usuario_id_raw)::BIGINT > 0
      THEN BTRIM(usuario_id_raw)::INTEGER ELSE NULL END AS usuario_id,
    CASE WHEN BTRIM(conteudo_id_raw) ~ '^\d+$'
      THEN BTRIM(conteudo_id_raw)::INTEGER ELSE NULL END AS conteudo_id,
    CASE WHEN avaliacao_raw ~ '^-?\d+(\.\d+)?$'
      THEN ROUND(avaliacao_raw::NUMERIC)::INTEGER ELSE NULL END AS avaliacao_numero,
    CASE WHEN data_raw ~ '^\d{4}-\d{2}-\d{2}$'
      THEN data_raw::DATE ELSE NULL END AS data,
    silver.tags_normalizadas(tags_raw) AS tags
  FROM base
),
refs AS (
  SELECT a.*, sc.conteudo_id AS conteudo_id_existe
  FROM padronizado a
  LEFT JOIN silver.conteudo sc ON sc.conteudo_id = a.conteudo_id
),
dedupe AS (
  SELECT *,
    ROW_NUMBER() OVER (
      PARTITION BY usuario_id, conteudo_id, data
      ORDER BY data_hora_ingestao, linha_ctid
    ) AS ocorrencia
  FROM refs
),
regras AS (
  SELECT *,
    CASE
      WHEN usuario_id IS NULL THEN 'USUARIO_INVALIDO'
      WHEN conteudo_id IS NULL OR conteudo_id_existe IS NULL THEN 'REFERENCIA_INEXISTENTE'
      WHEN ocorrencia > 1 THEN 'DUPLICADO'
      WHEN data IS NULL THEN 'DATA_INVALIDA'
      WHEN avaliacao_raw IS NOT NULL AND (avaliacao_numero IS NULL OR avaliacao_numero < 1 OR avaliacao_numero > 5)
        THEN 'AVALIACAO_FORA_DA_FAIXA'
      ELSE NULL
    END AS regra_violada
  FROM dedupe
)
SELECT
  usuario_id, conteudo_id, avaliacao_numero AS avaliacao, comentario, tags, data,
  origem, arquivo_origem, data_hora_ingestao, execucao_id,
  regra_violada,
  CASE regra_violada
    WHEN 'USUARIO_INVALIDO' THEN 'usuario_id ausente, nao numerico ou nao positivo na origem'
    WHEN 'REFERENCIA_INEXISTENTE' THEN 'conteudo_id ausente, nao numerico ou sem correspondencia em silver.conteudo'
    WHEN 'DUPLICADO' THEN 'chave de negocio (usuario_id, conteudo_id, data) duplicada no Bronze; mantida apenas a primeira ocorrencia'
    WHEN 'DATA_INVALIDA' THEN 'data ilegivel ou fora do formato esperado'
    WHEN 'AVALIACAO_FORA_DA_FAIXA' THEN 'avaliacao ilegivel ou fora da faixa 1-5'
    ELSE NULL
  END AS mensagem,
  ('comentarios:usuario_id=' || COALESCE(usuario_id_raw, 'NULL')
    || ',conteudo_id=' || COALESCE(conteudo_id_raw, 'NULL')
    || ',data=' || COALESCE(data_raw, 'NULL')) AS registro_id,
  payload_original::text AS payload_original
FROM regras
]]></sql>
