<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Se vier preenchido pelo workflow ou pelo hop-run, esse valor e mantido. Vazio gera um UUID.</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>orquestrador_inicio</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 00:10:00.000</created_date>
    <modified_date>2026/09/27 00:10:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Definir execucao_id</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql><![CDATA[SELECT COALESCE(NULLIF(btrim('${EXECUCAO_ID}'), ''), gen_random_uuid()::text) AS execucao_id]]></sql>
    <variables_active>Y</variables_active>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Publicar execucao_id</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>execucao_id</field_name>
        <variable_name>EXECUCAO_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <order>
    <hop>
      <from>Definir execucao_id</from>
      <to>Publicar execucao_id</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
</pipeline>
