  <transform>
    <type>ExecSql</type>
    <name>Reaplicar regras</name>
    <connection>pg_desafio</connection>
    <execute_each_row>Y</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <sql><![CDATA[
WITH entrada AS (
  SELECT
    ?::bigint     AS quarentena_id,
    ?::text       AS registro_id,
    ?::text       AS origem,
    ?::text       AS payload_original,
    ?::text       AS arquivo_origem,
    ?::timestamp  AS data_hora_ingestao,
    ?::text       AS execucao_id_bronze,
    ?::text       AS conteudo_id_raw,
    NULLIF(BTRIM(?::text), '') AS titulo,
    NULLIF(BTRIM(?::text), '') AS tipo_raw,
    NULLIF(BTRIM(?::text), '') AS categoria_raw,
    NULLIF(BTRIM(?::text), '') AS nivel_raw,
    NULLIF(BTRIM(?::text), '') AS carga_horaria_min_raw,
    NULLIF(BTRIM(?::text), '') AS data_publicacao_raw,
    NULLIF(BTRIM(?::text), '') AS descricao,
    NULLIF(BTRIM(?::text), '') AS autor,
    ?::text       AS execucao_id_reprocessamento
),
padronizado AS (
  SELECT *,
    CASE WHEN BTRIM(conteudo_id_raw) ~ '^\d+$'
      THEN BTRIM(conteudo_id_raw)::INTEGER ELSE NULL END AS conteudo_id,
    CASE UPPER(tipo_raw)
      WHEN 'ARTIGO' THEN 'Artigo' WHEN 'CURSO' THEN 'Curso' WHEN 'PODCAST' THEN 'Podcast'
      WHEN 'VÍDEO' THEN 'Vídeo' WHEN 'VIDEO' THEN 'Vídeo' ELSE tipo_raw END AS tipo,
    CASE UPPER(categoria_raw)
      WHEN 'BANCO DE DADOS' THEN 'Banco de Dados'
      WHEN 'BUSINESS INTELLIGENCE' THEN 'Business Intelligence'
      WHEN 'CIÊNCIA DE DADOS' THEN 'Ciência de Dados' WHEN 'CIENCIA DE DADOS' THEN 'Ciência de Dados'
      WHEN 'DEVOPS & CLOUD' THEN 'DevOps & Cloud'
      WHEN 'ENGENHARIA DE DADOS' THEN 'Engenharia de Dados'
      WHEN 'INTELIGÊNCIA ARTIFICIAL' THEN 'Inteligência Artificial' WHEN 'INTELIGENCIA ARTIFICIAL' THEN 'Inteligência Artificial'
      WHEN 'PROGRAMAÇÃO & SOFTWARE' THEN 'Programação & Software' WHEN 'PROGRAMACAO & SOFTWARE' THEN 'Programação & Software'
      WHEN 'SEGURANÇA & GOVERNANÇA' THEN 'Segurança & Governança' WHEN 'SEGURANCA & GOVERNANCA' THEN 'Segurança & Governança'
      ELSE categoria_raw END AS categoria,
    CASE UPPER(nivel_raw)
      WHEN 'BÁSICO' THEN 'Básico' WHEN 'BASICO' THEN 'Básico'
      WHEN 'INTERMEDIÁRIO' THEN 'Intermediário' WHEN 'INTERMEDIARIO' THEN 'Intermediário'
      WHEN 'AVANÇADO' THEN 'Avançado' WHEN 'AVANCADO' THEN 'Avançado'
      ELSE nivel_raw END AS nivel,
    CASE WHEN carga_horaria_min_raw ~ '^-?\d+(\.\d+)?$'
      THEN ROUND(carga_horaria_min_raw::NUMERIC)::INTEGER ELSE NULL END AS carga_horaria_min,
    CASE WHEN data_publicacao_raw ~ '^\d{4}-\d{2}-\d{2}$'
      THEN data_publicacao_raw::DATE ELSE NULL END AS data_publicacao
  FROM entrada
),
regras AS (
  SELECT *,
    CASE
      WHEN conteudo_id IS NULL THEN 'ID_INVALIDO'
      WHEN EXISTS (SELECT 1 FROM silver.conteudo s WHERE s.conteudo_id = padronizado.conteudo_id) THEN 'DUPLICADO'
      WHEN tipo IS NULL OR tipo NOT IN ('Artigo','Curso','Podcast','Vídeo') THEN 'TIPO_FORA_DO_DOMINIO'
      WHEN categoria IS NULL OR categoria NOT IN (
        'Banco de Dados','Business Intelligence','Ciência de Dados','DevOps & Cloud',
        'Engenharia de Dados','Inteligência Artificial','Programação & Software','Segurança & Governança'
      ) THEN 'CATEGORIA_FORA_DO_DOMINIO'
      WHEN nivel IS NULL OR nivel NOT IN ('Básico','Intermediário','Avançado') THEN 'NIVEL_FORA_DO_DOMINIO'
      ELSE NULL
    END AS regra_violada
  FROM padronizado
),
insere_silver AS (
  INSERT INTO silver.conteudo (
    conteudo_id, titulo, tipo, categoria, nivel, carga_horaria_min, data_publicacao,
    descricao, autor, origem, arquivo_origem, data_hora_ingestao, execucao_id
  )
  SELECT conteudo_id, titulo, tipo, categoria, nivel, carga_horaria_min, data_publicacao,
         descricao, autor, origem, arquivo_origem, data_hora_ingestao, execucao_id_bronze
  FROM regras
  WHERE regra_violada IS NULL
  RETURNING conteudo_id
),
marca_reprocessado AS (
  UPDATE quarentena.registro q
  SET status = 'reprocessado'
  WHERE q.id IN (SELECT quarentena_id FROM regras WHERE regra_violada IS NULL)
     OR q.registro_id IN (SELECT registro_id FROM regras WHERE regra_violada IS NULL)
  RETURNING q.id
),
nova_quarentena AS (
  INSERT INTO quarentena.registro (
    registro_id, origem, regra_violada, mensagem, execucao_id, payload_original, status
  )
  SELECT
    registro_id, origem, regra_violada,
    CASE regra_violada
      WHEN 'ID_INVALIDO' THEN 'conteudo_id ausente ou nao numerico na origem'
      WHEN 'DUPLICADO' THEN 'conteudo_id ja existe em silver.conteudo; nada a reprocessar'
      WHEN 'TIPO_FORA_DO_DOMINIO' THEN 'tipo fora do dominio oficial (Artigo, Curso, Podcast, Video)'
      WHEN 'CATEGORIA_FORA_DO_DOMINIO' THEN 'categoria fora do dominio oficial das 8 categorias'
      WHEN 'NIVEL_FORA_DO_DOMINIO' THEN 'nivel fora do dominio oficial (Basico, Intermediario, Avancado)'
    END,
    execucao_id_reprocessamento, payload_original, 'pendente'
  FROM regras
  WHERE regra_violada IS NOT NULL
  RETURNING id
)
SELECT
  (SELECT count(*) FROM insere_silver)      AS aprovados,
  (SELECT count(*) FROM nova_quarentena)    AS rejeitados_novamente
]]></sql>
