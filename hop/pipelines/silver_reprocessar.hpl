  <transform>
    <type>TableInput</type>
    <name>Ler quarentena pendente</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <lookup/>
    <sql><![CDATA[
SELECT
  q.id              AS quarentena_id,
  q.registro_id,
  q.origem,
  q.payload_original,
  q.arquivo_origem,
  q.data_hora_ingestao,
  q.execucao_id_bronze
FROM (
  SELECT DISTINCT ON (registro_id)
    id,
    registro_id,
    origem,
    payload_original,
    payload_original::jsonb ->> 'arquivo_origem'     AS arquivo_origem,
    (payload_original::jsonb ->> 'data_hora_ingestao')::timestamp AS data_hora_ingestao,
    payload_original::jsonb ->> 'execucao_id'        AS execucao_id_bronze
  FROM quarentena.registro
  WHERE status = 'pendente' AND origem = 'catalogo'
  ORDER BY registro_id, id DESC
) q
]]></sql>
