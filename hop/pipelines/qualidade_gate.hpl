<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Execucao que precisa ter passado nos testes criticos antes da Gold.</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>qualidade_gate</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/26 21:45:00.000</created_date>
    <modified_date>2026/09/26 21:45:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Bloquear se critico</name>
    <connection>pg_desafio</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql><![CDATA[SELECT qualidade.bloquear_se_critico('${EXECUCAO_ID}') AS status]]></sql>
    <variables_active>Y</variables_active>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Logar gate</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>QUALIDADE LIBEROU A GOLD</logmessage>
    <loglevel>Basic</loglevel>
    <fields>
      <field><name>status</name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
  </transform>
  <order>
    <hop>
      <from>Bloquear se critico</from>
      <to>Logar gate</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
</pipeline>
