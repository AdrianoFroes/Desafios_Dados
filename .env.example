# ==============================================================================
# Plataforma Educacional — Variáveis de Ambiente (.env)
# ==============================================================================
# Instruções:
# Copie este arquivo para .env antes de executar a aplicação:
#   Windows (CMD): copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Os valores padrão abaixo já estão prontos para rodar no Docker.
# Se desejar alterar portas ou senhas, modifique este arquivo.
# ==============================================================================

# Conexão com o PostgreSQL (porta 5433 para não colidir com Postgres local padrão)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plataforma_educacional

# Conexão com o MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=plataforma_educacional

# Configurações opcionais de Embeddings (descomente para customizar)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
