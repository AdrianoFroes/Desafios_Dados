# ==============================================================================
# Plataforma Educacional ??? vari??veis de ambiente
# ==============================================================================
# N??o coloque valores reais aqui. scripts/00_setup.ps1 copia este arquivo para
# .env (fora do Git) e gera valores aleat??rios para tudo que estiver "__gerar__".
# ==============================================================================

# PostgreSQL do projeto (porta publicada no host; troque se 5433 estiver ocupada)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__gerar__
POSTGRES_DB=plataforma_educacional

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=plataforma_educacional

# Superset
SUPERSET_SECRET_KEY=__gerar__
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# senha do papel somente leitura usado pelo Superset (sql/papeis_acesso.sql)
BI_PASSWORD=__gerar__
ALERTA_DESTINATARIO=aluno3@ficticio.edu.br
ALERTA_CRON=*/5 * * * *
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_MAIL_FROM=superset@ficticio.edu.br

# LGPD: salt do hashing (sql/lgpd.sql). Nunca versionar.
LGPD_SALT=__gerar__

# OpenMetadata (docker-compose-openmetadata-oficial.yml)
OM_POSTGRES_PORT=5437
OM_AIRFLOW_PORT=8090
# senha do papel om_catalogo usado pela ingestao (sql/papeis_acesso.sql)
OM_CATALOGO_PASSWORD=__gerar__
OM_ADMIN_EMAIL=admin
OM_ADMIN_PASSWORD=admin
# token do bot de ingest??o: Settings > Bots > ingestion-bot (opcional; o script
# gera um JWT pelo login do admin quando estiver vazio)
OM_JWT_TOKEN=

# Configura????es opcionais de Embeddings (descomente para customizar)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
